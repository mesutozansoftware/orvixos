#!/bin/sh

# labwc bu betiği oturum başında çalıştırır. Eksik isteğe bağlı bir bileşen,
# tüm masaüstü oturumunun kapanmasına neden olmamalıdır.

log() {
    printf '%s\n' "trlde-autostart: $*" >&2
}

state_home=${XDG_STATE_HOME:-$HOME/.local/state}
install -d -m 0700 "$state_home/trlde"
log_file=$state_home/trlde/session.log
if [ -r "$log_file" ] && [ "$(wc -c < "$log_file")" -gt 1048576 ]; then
    mv -f "$log_file" "$log_file.old"
fi
exec >>"$log_file" 2>&1

log "oturum bileşenleri başlatılıyor"

start_if_available() {
    program=$1
    shift

    if command -v "$program" >/dev/null 2>&1; then
        "$program" "$@" &
    else
        log "$program bulunamadı; bu bileşen atlandı."
    fi
}

share_dir=${TRLDE_SHARE_DIR:-/usr/share/trlde}
config_home=${XDG_CONFIG_HOME:-$HOME/.config}
wallpaper=${TRLDE_WALLPAPER:-/usr/share/backgrounds/trlde/orvixos.svg}

# Sistem varsayılanı (/etc/xdg/mimeapps.list) varsa önce o tarayıcı denenir.
trlde_browsers() {
    xdg-mime query default x-scheme-handler/https 2>/dev/null || true
    printf '%s\n' vira-browser.desktop firefox-esr.desktop chromium.desktop firefox.desktop
}

first_run_marker=$config_home/trlde/defaults-applied
if [ ! -e "$first_run_marker" ]; then
    install -d -m 0700 "$config_home/trlde"
    if command -v xdg-user-dirs-update >/dev/null 2>&1; then
        while IFS=: read -r directory folder; do
            install -d -m 0700 "$HOME/$folder"
            xdg-user-dirs-update --set "$directory" "$HOME/$folder" || true
        done <<'EOF'
DESKTOP:Masaüstü
DOWNLOAD:İndirilenler
TEMPLATES:Şablonlar
PUBLICSHARE:Genel
DOCUMENTS:Belgeler
MUSIC:Müzik
PICTURES:Resimler
VIDEOS:Videolar
EOF
    fi
    command -v gsettings >/dev/null 2>&1 && {
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark || true
        gsettings set org.gnome.desktop.interface gtk-theme Adwaita-dark || true
        if [ -d /usr/share/icons/Papirus-Dark ]; then
            gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark || true
        else
            gsettings set org.gnome.desktop.interface icon-theme Adwaita || true
        fi
    }
    command -v xdg-mime >/dev/null 2>&1 && {
        for browser in $(trlde_browsers); do
            if [ -r "/usr/share/applications/$browser" ]; then
                xdg-mime default "$browser" x-scheme-handler/http || true
                xdg-mime default "$browser" x-scheme-handler/https || true
                break
            fi
        done
        xdg-mime default thunar.desktop inode/directory || true
        for editor in org.xfce.mousepad.desktop mousepad.desktop; do
            if [ -r "/usr/share/applications/$editor" ]; then
                xdg-mime default "$editor" text/plain || true
                break
            fi
        done
    }
    : > "$first_run_marker"
fi

if [ -r "$config_home/trlde/wallpaper" ]; then
    IFS= read -r saved_wallpaper < "$config_home/trlde/wallpaper" || true
    if [ -n "${saved_wallpaper:-}" ] && [ -r "$saved_wallpaper" ]; then
        wallpaper=$saved_wallpaper
    fi
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
        XDG_SESSION_TYPE XDG_RUNTIME_DIR >/dev/null 2>&1 || true
fi

# Kullanıcı yöneticisi bir TTY yüzünden oturumlar arasında yaşayabilir. Portalı
# yeni Wayland ortamını okuyacak biçimde yenilemek, ekran paylaşımını her girişte
# güvenilir şekilde ayağa kaldırır.
systemctl --user restart xdg-desktop-portal.service >/dev/null 2>&1 || true
systemctl --user enable --now trlde-update.timer >/dev/null 2>&1 || true
systemctl --user restart trlde-clipboard.service >/dev/null 2>&1 || true

if command -v wlr-randr >/dev/null 2>&1; then
    if ! trlde-display-profiles --apply-last >/dev/null 2>&1; then
        # Kayıtlı profil yoksa yüksek çözünürlüklü ekranlar 2x ölçeklenir;
        # böylece yazı ve ikonlar küçük ya da pikselli görünmez.
        wlr-randr | awk '
            /^[^ ]/ { output = $1 }
            /current/ { split($1, size, "x"); if (size[1] + 0 >= 2400) print output }
        ' | while IFS= read -r output; do
            wlr-randr --output "$output" --scale 2 || true
        done
    fi
fi

# Masaüstü: simgeler, seçim karesi ve duvar kâğıdı pcmanfm-qt'den gelir
# (Wayland layer-shell). Yoksa yalnızca duvar kâğıdı çizilir.
if command -v pcmanfm-qt >/dev/null 2>&1; then
    profile_dir=$config_home/pcmanfm-qt/orvixos
    if [ ! -r "$profile_dir/settings.conf" ]; then
        install -d -m 0700 "$profile_dir"
        cp "$share_dir/pcmanfm-qt/orvixos/settings.conf" "$profile_dir/settings.conf"
    fi
    sed -i "s|^Wallpaper=.*|Wallpaper=$wallpaper|" "$profile_dir/settings.conf" 2>/dev/null || true
    # İlk açılışta oturum hazır olmadan çökebilir; kendiliğinden yeniden başlar.
    (while :; do
        QT_QPA_PLATFORMTHEME=lxqt pcmanfm-qt --desktop --profile=orvixos
        sleep 2
    done) &
else
    start_if_available swaybg -i "$wallpaper" -m fill
fi

if ! systemctl --user start mako.service >/dev/null 2>&1; then
    start_if_available mako -c "$share_dir/mako/config"
fi

# Görev çubuğu: sabitlenmiş uygulamalarla üretilen ayar (trlde-taskbar).
# Açık pencereler izlenir (sabit simgelerdeki "açık" çizgisi için).
(while :; do trlde-taskbar --poll; sleep 2; done) &
(while :; do
    if waybar_config=$(trlde-taskbar --generate 2>/dev/null); then
        waybar -c "$waybar_config" -s "${XDG_CACHE_HOME:-$HOME/.cache}/trlde/waybar-style.css"
    else
        waybar -c "$share_dir/waybar/config.jsonc" -s "$share_dir/waybar/style.css"
    fi
    # trlde-taskbar --restart görev çubuğunu kendisi başlatır; çift başlamasın.
    sleep 3
    while pgrep -x waybar >/dev/null 2>&1; do sleep 2; done
done) &
# Ağ seçimi görev çubuğundaki Wi-Fi panelinden (trlde-wifi) yapılır; ayrı bir
# ağ simgesi (nm-applet) bellekte yer tutmasın diye başlatılmaz.
# Bluetooth simgesi yalnızca Bluetooth donanımı varsa başlar.
if ls /sys/class/bluetooth/hci* >/dev/null 2>&1; then
    start_if_available blueman-applet
fi
start_if_available swayidle -w timeout 600 "trlde-lock" before-sleep "trlde-lock"
# Canlı sistemde kurulum penceresi zaten çıkıyor; ikinci karşılama gösterilmez.
# Dokunmatik yüzey hareketleri (yalnızca "input" grubundaki kullanıcılar için)
if id -nG | tr ' ' '\n' | grep -qx input; then
    start_if_available trlde-gestures
fi
# İlk açılışta kurulum sihirbazı (tarayıcı, tema, hızlı kurulum)
[ -d /run/live/medium ] || start_if_available orvix-welcome --first-run

polkit_agent=
for candidate in \
    /usr/libexec/polkit-mate-authentication-agent-1 \
    /usr/lib/mate-polkit/polkit-mate-authentication-agent-1; do
    if [ -x "$candidate" ]; then
        polkit_agent=$candidate
        break
    fi
done
if [ -n "$polkit_agent" ]; then
    "$polkit_agent" &
else
    log "Polkit kimlik doğrulama aracısı bulunamadı."
fi

# Dağıtımın eklediği oturum başlangıç betikleri (ör. canlı sistemde kurulum
# karşılama penceresi).
for hook in /etc/trlde/autostart.d/*; do
    [ -x "$hook" ] && "$hook" &
done

log "oturum bileşenleri başlatıldı"
