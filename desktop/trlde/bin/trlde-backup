#!/usr/bin/python3

"""OrvixOS kişisel dosya yedekleme ve kurtarma aracı."""

import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import threading
from datetime import datetime

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk


def xdg_dir(name, fallback):
    try:
        value = subprocess.run(
            ["xdg-user-dir", name], check=False, capture_output=True, text=True
        ).stdout.strip()
        return Path(value) if value else Path.home() / fallback
    except OSError:
        return Path.home() / fallback


class Backup(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.trlde.Backup")
        self.window = None
        self.busy = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window { background: #111820; color: #e7edf2; }
            headerbar { background: #18222d; color: #fff; border-bottom: 1px solid #2ee6d6; }
            .hero { font-size: 24px; font-weight: 800; color: #fff; }
            .accent { color: #2ee6d6; font-weight: 700; }
            .muted { color: #91a0ad; }
            button { min-height: 46px; border-radius: 10px; background: #202c38; color: #e7edf2; }
            button:hover { background: #314253; color: #2ee6d6; }
            button.suggested-action { background: #2ee6d6; color: #07101d; }
            progressbar trough { min-height: 8px; background: #273442; }
            progressbar progress { background: #2ee6d6; }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("OrvixOS Yedekleme ve Kurtarma")
        self.window.set_default_size(650, 460)
        header = Gtk.HeaderBar(title="OrvixOS Yedekleme ve Kurtarma")
        header.set_show_close_button(True)
        self.window.set_titlebar(header)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        outer.set_border_width(24)
        self.window.add(outer)
        title = Gtk.Label(label="Kişisel dosyalarını güvenle sakla", xalign=0)
        title.get_style_context().add_class("hero")
        outer.pack_start(title, False, False, 0)
        note = Gtk.Label(
            label=(
                "Belgeler, İndirilenler, Resimler, Müzik, Videolar, Masaüstü ve OrvixOS "
                "ayarları tek bir sıkıştırılmış arşive yazılır. Sistem dosyaları değiştirilmez."
            ),
            xalign=0,
            wrap=True,
        )
        note.get_style_context().add_class("muted")
        outer.pack_start(note, False, False, 0)
        self.backup_button = Gtk.Button(label="Yeni Yedek Oluştur")
        self.backup_button.get_style_context().add_class("suggested-action")
        self.backup_button.connect("clicked", self.choose_backup_folder)
        outer.pack_start(self.backup_button, False, False, 4)
        self.restore_button = Gtk.Button(label="Yedekten Kişisel Dosyaları Kurtar")
        self.restore_button.connect("clicked", self.choose_archive)
        outer.pack_start(self.restore_button, False, False, 0)
        self.open_button = Gtk.Button(label="Yedek Klasörünü Aç")
        self.open_button.connect("clicked", lambda *_: self.open_default_folder())
        outer.pack_start(self.open_button, False, False, 0)
        self.progress = Gtk.ProgressBar()
        outer.pack_start(self.progress, False, False, 6)
        self.status = Gtk.Label(label="Yedekleme için hazır.", xalign=0, wrap=True)
        self.status.get_style_context().add_class("muted")
        outer.pack_start(self.status, False, False, 0)
        self.window.show_all()

    def default_folder(self):
        target = xdg_dir("DOCUMENTS", "Belgeler") / "OrvixOS Yedekleri"
        target.mkdir(mode=0o700, parents=True, exist_ok=True)
        return target

    def set_busy(self, active, message):
        self.busy = active
        self.backup_button.set_sensitive(not active)
        self.restore_button.set_sensitive(not active)
        self.progress.set_pulse_step(0.08)
        self.status.set_text(message)
        if active:
            GLib.timeout_add(120, self.pulse)

    def pulse(self):
        if self.busy:
            self.progress.pulse()
            return True
        self.progress.set_fraction(1.0)
        return False

    def choose_backup_folder(self, _button):
        chooser = Gtk.FileChooserNative(
            title="Yedeğin yazılacağı klasörü seç",
            transient_for=self.window,
            action=Gtk.FileChooserAction.SELECT_FOLDER,
            accept_label="Seç",
            cancel_label="İptal",
        )
        chooser.set_current_folder(str(self.default_folder()))
        if chooser.run() == Gtk.ResponseType.ACCEPT:
            self.create_backup(Path(chooser.get_filename()))
        chooser.destroy()

    def backup_sources(self):
        sources = []
        for name, fallback in (
            ("DESKTOP", "Masaüstü"),
            ("DOWNLOAD", "İndirilenler"),
            ("DOCUMENTS", "Belgeler"),
            ("MUSIC", "Müzik"),
            ("PICTURES", "Resimler"),
            ("VIDEOS", "Videolar"),
        ):
            path = xdg_dir(name, fallback)
            if path.exists() and path not in sources:
                sources.append(path)
        trlde_config = Path.home() / ".config" / "trlde"
        if trlde_config.exists():
            sources.append(trlde_config)
        return sources

    def create_backup(self, folder):
        folder.mkdir(mode=0o700, parents=True, exist_ok=True)
        target = folder / f"OrvixOS-Yedek-{datetime.now():%Y%m%d-%H%M%S}.tar.gz"
        cache = Path.home() / ".cache" / "trlde"
        cache.mkdir(mode=0o700, parents=True, exist_ok=True)
        temporary_target = cache / (target.name + ".partial")
        self.set_busy(True, "Kişisel dosyalar yedekleniyor…")

        def worker():
            error = ""
            try:
                excluded = folder.resolve()

                def archive_filter(member):
                    candidate = (Path.home() / member.name).resolve()
                    if candidate == excluded or excluded in candidate.parents:
                        return None
                    return member

                with tarfile.open(temporary_target, "w:gz", compresslevel=6) as archive:
                    for source in self.backup_sources():
                        archive.add(
                            source,
                            arcname=str(source.relative_to(Path.home())),
                            recursive=True,
                            filter=archive_filter,
                        )
                os.replace(temporary_target, target)
            except (OSError, tarfile.TarError, ValueError) as caught:
                error = str(caught)
                try:
                    temporary_target.unlink()
                except OSError:
                    pass
            GLib.idle_add(self.finish, target, error, "Yedek oluşturuldu")

        threading.Thread(target=worker, daemon=True).start()

    def choose_archive(self, _button):
        chooser = Gtk.FileChooserNative(
            title="OrvixOS yedeğini seç",
            transient_for=self.window,
            action=Gtk.FileChooserAction.OPEN,
            accept_label="Seç",
            cancel_label="İptal",
        )
        chooser.set_current_folder(str(self.default_folder()))
        file_filter = Gtk.FileFilter()
        file_filter.set_name("OrvixOS yedekleri (*.tar.gz)")
        file_filter.add_pattern("*.tar.gz")
        chooser.add_filter(file_filter)
        if chooser.run() == Gtk.ResponseType.ACCEPT:
            archive = Path(chooser.get_filename())
            chooser.destroy()
            self.confirm_restore(archive)
            return
        chooser.destroy()

    def confirm_restore(self, archive):
        dialog = Gtk.MessageDialog(
            transient_for=self.window,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.CANCEL,
            text="Kişisel dosyalar yedekten geri yüklensin mi?",
        )
        dialog.format_secondary_text(
            "Aynı adlı mevcut dosyalar yedekteki sürümlerle değiştirilebilir. Sistem dosyalarına dokunulmaz."
        )
        dialog.add_button("Geri Yükle", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self.restore(archive)

    def safe_members(self, archive):
        home = Path.home().resolve()
        allowed = {
            "Masaüstü", "İndirilenler", "Belgeler", "Müzik", "Resimler", "Videolar", ".config"
        }
        for member in archive.getmembers():
            relative = Path(member.name)
            if relative.is_absolute() or ".." in relative.parts or not relative.parts:
                raise ValueError("Yedek güvenli olmayan bir dosya yolu içeriyor.")
            if relative.parts[0] not in allowed:
                raise ValueError("Yedek izin verilmeyen bir klasör içeriyor.")
            if relative.parts[0] == ".config" and relative.parts[1:2] != ("trlde",):
                raise ValueError("Yedek izin verilmeyen bir ayar klasörü içeriyor.")
            destination = (home / relative).resolve()
            if home not in destination.parents and destination != home:
                raise ValueError("Yedek ev klasörünün dışına çıkmaya çalışıyor.")
            if not (member.isdir() or member.isfile()):
                continue
            yield member, destination

    def restore(self, source):
        self.set_busy(True, "Kişisel dosyalar geri yükleniyor…")

        def worker():
            error = ""
            try:
                with tarfile.open(source, "r:gz") as archive:
                    for member, destination in self.safe_members(archive):
                        if member.isdir():
                            destination.mkdir(mode=member.mode & 0o777 or 0o700, parents=True, exist_ok=True)
                            continue
                        destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
                        extracted = archive.extractfile(member)
                        if extracted is None:
                            continue
                        temporary = destination.with_name(destination.name + ".trlde-restore")
                        with extracted, open(temporary, "wb") as output_file:
                            shutil.copyfileobj(extracted, output_file)
                        os.chmod(temporary, member.mode & 0o777 or 0o600)
                        os.replace(temporary, destination)
            except (OSError, tarfile.TarError, ValueError) as caught:
                error = str(caught)
            GLib.idle_add(self.finish, source, error, "Kişisel dosyalar geri yüklendi")

        threading.Thread(target=worker, daemon=True).start()

    def finish(self, path, error, success):
        self.busy = False
        self.backup_button.set_sensitive(True)
        self.restore_button.set_sensitive(True)
        self.status.set_text("Hata: " + error if error else f"{success}: {path}")
        return False

    def open_default_folder(self):
        subprocess.Popen(["xdg-open", str(self.default_folder())], start_new_session=True)


Backup().run(sys.argv)
