#!/bin/sh

set -eu

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-tr}}}}" in
    tr*|C|C.*|POSIX) T() { printf '%s' "$1"; } ;;
    *) T() { printf '%s' "$2"; } ;;
esac

if command -v trlde-drawer >/dev/null 2>&1; then
    exec trlde-drawer
fi

if pgrep -x wofi >/dev/null 2>&1; then
    pkill -x wofi
    exit 0
fi

exec wofi \
    --show drun \
    --normal-window \
    --allow-images \
    --insensitive \
    --prompt "$(T "Uygulama ara" "Search apps")" \
    --width 640 \
    --height 480 \
    --style /usr/share/trlde/wofi/style.css
