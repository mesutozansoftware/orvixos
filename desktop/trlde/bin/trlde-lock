#!/bin/sh

set -eu

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-tr}}}}" in
    tr*|C|C.*|POSIX) T() { printf '%s' "$1"; } ;;
    *) T() { printf '%s' "$2"; } ;;
esac

if ! command -v swaylock >/dev/null 2>&1; then
    command -v notify-send >/dev/null 2>&1 && \
        notify-send "OrvixOS" "$(T "Ekran kilidi kullanılamıyor." "Screen lock is unavailable.")"
    exit 1
fi

exec swaylock --daemonize \
    --color 111820 \
    --font "Noto Sans" \
    --font-size 22 \
    --indicator-idle-visible \
    --indicator-radius 86 \
    --indicator-thickness 9 \
    --inside-color 18222ddd \
    --ring-color 39d6c5ff \
    --key-hl-color d62e4fff \
    --bs-hl-color ffc857ff \
    --text-color ffffffff \
    --ring-wrong-color d62e4fff \
    --inside-wrong-color 3a1520ee \
    --show-failed-attempts \
    --show-keyboard-layout
