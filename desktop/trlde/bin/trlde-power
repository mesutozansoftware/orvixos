#!/bin/sh

set -eu

case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-tr}}}}" in
    tr*|C|C.*|POSIX) T() { printf '%s' "$1"; } ;;
    *) T() { printf '%s' "$2"; } ;;
esac

choose_action() {
    printf '%s\n' \
        "$(T "Ekranı Kilitle" "Lock Screen")" \
        "$(T "Uykuya Al" "Sleep")" \
        "$(T "Oturumu Kapat" "Log Out")" \
        "$(T "Yeniden Başlat" "Restart")" \
        "$(T "Bilgisayarı Kapat" "Shut Down")" |
        wofi --dmenu --normal-window --insensitive \
            --prompt "$(T "Güç Menüsü" "Power Menu")" --width 430 --height 360 \
            --style /usr/share/trlde/wofi/style.css
}

confirm_action() {
    answer=$(
        printf '%s\n' "$(T "Vazgeç" "Cancel")" "$(T "Evet" "Yes")" |
            wofi --dmenu --normal-window \
                --prompt "$1" --width 390 --height 220 \
                --style /usr/share/trlde/wofi/style.css
    ) || return 1
    [ "$answer" = "$(T "Evet" "Yes")" ]
}

action=${1:-}
if [ -z "$action" ]; then
    selection=$(choose_action) || exit 0
    case "$selection" in
        "$(T "Ekranı Kilitle" "Lock Screen")") action=lock ;;
        "$(T "Uykuya Al" "Sleep")") action=suspend ;;
        "$(T "Oturumu Kapat" "Log Out")") action=logout ;;
        "$(T "Yeniden Başlat" "Restart")") action=reboot ;;
        "$(T "Bilgisayarı Kapat" "Shut Down")") action=poweroff ;;
        *) exit 0 ;;
    esac
fi

case "$action" in
    lock)
        exec trlde-lock
        ;;
    suspend)
        confirm_action "$(T "Bilgisayar uykuya alınsın mı?" "Put the computer to sleep?")" || exit 0
        trlde-lock
        systemctl suspend
        ;;
    logout)
        confirm_action "$(T "OrvixOS oturumu kapatılsın mı?" "Log out of OrvixOS?")" || exit 0
        if [ -n "${LABWC_PID:-}" ]; then
            exec labwc --exit
        fi
        pkill -TERM -x labwc
        ;;
    reboot)
        confirm_action "$(T "Bilgisayar yeniden başlatılsın mı?" "Restart the computer?")" || exit 0
        systemctl reboot
        ;;
    poweroff)
        confirm_action "$(T "Bilgisayar kapatılsın mı?" "Shut down the computer?")" || exit 0
        systemctl poweroff
        ;;
esac
