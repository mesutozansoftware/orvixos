#!/usr/bin/python3

"""OrvixOS ekran kayıt aracı ve Waybar durum sağlayıcısı."""

import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading
from datetime import datetime


def runtime_state():
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/trlde-{os.getuid()}"))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    return runtime / "trlde-recorder.json"


def load_state():
    try:
        data = json.loads(runtime_state().read_text(encoding="utf-8"))
        pid = int(data["pid"])
        os.kill(pid, 0)
        comm = Path(f"/proc/{pid}/comm")
        if comm.exists() and comm.read_text(encoding="utf-8").strip() != "wf-recorder":
            raise ProcessLookupError
        return data
    except (OSError, ValueError, KeyError, json.JSONDecodeError, ProcessLookupError):
        try:
            runtime_state().unlink()
        except OSError:
            pass
        return None


def stop_recording():
    state = load_state()
    if not state:
        return False
    try:
        os.killpg(int(state["pid"]), signal.SIGINT)
    except OSError:
        try:
            os.kill(int(state["pid"]), signal.SIGINT)
        except OSError:
            pass
    try:
        runtime_state().unlink()
    except OSError:
        pass
    return True


if "--status" in sys.argv:
    current = load_state()
    if current:
        print(json.dumps({"text": "● Kayıt", "class": "recording", "tooltip": current["path"]}))
    else:
        print(json.dumps({"text": "", "class": "idle", "tooltip": "Ekran kaydı kapalı"}))
    raise SystemExit(0)

if "--stop" in sys.argv:
    raise SystemExit(0 if stop_recording() else 1)

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk
try:
    import sys as _trlde_sys
    _trlde_sys.path.insert(0, "/usr/share/trlde/i18n")
    import trlde_i18n
    trlde_i18n.install()
except Exception:
    pass


def notify(message):
    if GLib.find_program_in_path("notify-send"):
        subprocess.Popen(["notify-send", "OrvixOS Ekran Kaydı", message], start_new_session=True)


class Recorder(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.trlde.Recorder")
        self.window = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window { background: #111820; color: #e7edf2; }
            headerbar { background: #18222d; color: #fff; border-bottom: 1px solid #2ee6d6; }
            .hero { font-size: 22px; font-weight: 800; color: #fff; }
            .muted { color: #91a0ad; }
            button { min-height: 44px; border-radius: 10px; background: #202c38; color: #e7edf2; }
            button:hover { background: #314253; color: #2ee6d6; }
            button.suggested-action { background: #2ee6d6; color: #07101d; }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def do_activate(self):
        if self.window:
            self.window.present()
            return
        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("OrvixOS Ekran Kaydı")
        self.window.set_default_size(540, 380)
        header = Gtk.HeaderBar(title="OrvixOS Ekran Kaydı")
        header.set_show_close_button(True)
        self.window.set_titlebar(header)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        outer.set_border_width(22)
        self.window.add(outer)
        title = Gtk.Label(label="Ekranını video olarak kaydet", xalign=0)
        title.get_style_context().add_class("hero")
        outer.pack_start(title, False, False, 0)
        self.status = Gtk.Label(xalign=0, wrap=True)
        self.status.get_style_context().add_class("muted")
        outer.pack_start(self.status, False, False, 0)
        self.audio = Gtk.CheckButton(label="Sistem sesini de kaydet")
        outer.pack_start(self.audio, False, False, 0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        grid.set_column_homogeneous(True)
        outer.pack_start(grid, False, False, 4)
        full = Gtk.Button(label="Tüm Ekranı Kaydet")
        full.connect("clicked", lambda *_: self.start("full"))
        grid.attach(full, 0, 0, 1, 1)
        area = Gtk.Button(label="Alan Seçerek Kaydet")
        area.connect("clicked", lambda *_: self.start("area"))
        grid.attach(area, 1, 0, 1, 1)
        self.stop_button = Gtk.Button(label="Kaydı Durdur")
        self.stop_button.get_style_context().add_class("suggested-action")
        self.stop_button.connect("clicked", lambda *_: self.stop())
        grid.attach(self.stop_button, 0, 1, 1, 1)
        folder = Gtk.Button(label="Kayıt Klasörünü Aç")
        folder.connect("clicked", lambda *_: self.open_folder())
        grid.attach(folder, 1, 1, 1, 1)
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)
        self.window.show_all()

    def video_dir(self):
        result = subprocess.run(
            ["xdg-user-dir", "VIDEOS"], check=False, capture_output=True, text=True
        )
        base = Path(result.stdout.strip() or Path.home() / "Videolar")
        target = base / "OrvixOS"
        target.mkdir(mode=0o700, parents=True, exist_ok=True)
        return target

    def start(self, mode):
        if load_state():
            self.status.set_text("Bir ekran kaydı zaten sürüyor.")
            return
        if not GLib.find_program_in_path("wf-recorder"):
            self.status.set_text("wf-recorder bulunamadı.")
            return
        self.status.set_text("Kayıt hazırlanıyor…")
        with_audio = self.audio.get_active()

        def worker():
            geometry = ""
            if mode == "area":
                selected = subprocess.run(
                    ["slurp"], check=False, capture_output=True, text=True
                )
                if selected.returncode:
                    GLib.idle_add(self.finish_start, None, "Alan seçimi iptal edildi.")
                    return
                geometry = selected.stdout.strip()
            target = self.video_dir() / f"OrvixOS-Kayit-{datetime.now():%Y%m%d-%H%M%S}.mp4"
            argv = ["wf-recorder", "-f", str(target)]
            if geometry:
                argv[1:1] = ["-g", geometry]
            if with_audio:
                argv.insert(1, "--audio")
            try:
                process = subprocess.Popen(
                    argv,
                    stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL,
                    start_new_session=True,
                )
                runtime_state().write_text(
                    json.dumps({"pid": process.pid, "path": str(target)}), encoding="utf-8"
                )
                os.chmod(runtime_state(), 0o600)
                GLib.idle_add(self.finish_start, str(target), "")
            except OSError as error:
                GLib.idle_add(self.finish_start, None, str(error))

        threading.Thread(target=worker, daemon=True).start()

    def finish_start(self, target, error):
        if target:
            notify("Kayıt başladı. Paneldeki kırmızı kayıt göstergesinden durdurabilirsin.")
            self.status.set_text("Kayıt sürüyor: " + target)
        else:
            self.status.set_text(error)
        self.refresh()
        return False

    def stop(self):
        state = load_state()
        if stop_recording():
            notify("Kayıt tamamlandı: " + state["path"])
        self.refresh()

    def open_folder(self):
        subprocess.Popen(["xdg-open", str(self.video_dir())], start_new_session=True)

    def refresh(self):
        state = load_state()
        self.stop_button.set_sensitive(bool(state))
        if state:
            self.status.set_text("Kayıt sürüyor: " + state["path"])
        elif not self.status.get_text() or self.status.get_text().startswith("Kayıt sürüyor"):
            self.status.set_text("Kayıtlar Videolar/OrvixOS klasörüne MP4 olarak kaydedilir.")
        return True


Recorder().run(sys.argv)
