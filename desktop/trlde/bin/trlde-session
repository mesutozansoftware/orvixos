#!/bin/sh

set -eu

export XDG_CURRENT_DESKTOP=TRLDE
export XDG_SESSION_DESKTOP=trlde
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland

# Klavye düzeni: sistem ayarı (/etc/default/keyboard) labwc'ye aktarılır;
# aksi halde labwc ABD düzeniyle açılır ve Türkçe harfler yazılamaz.
if [ -r /etc/default/keyboard ]; then
    . /etc/default/keyboard
    [ -n "${XKBLAYOUT:-}" ] && export XKB_DEFAULT_LAYOUT="$XKBLAYOUT"
    [ -n "${XKBVARIANT:-}" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
    [ -n "${XKBMODEL:-}" ] && export XKB_DEFAULT_MODEL="$XKBMODEL"
    [ -n "${XKBOPTIONS:-}" ] && export XKB_DEFAULT_OPTIONS="$XKBOPTIONS"
fi

# Sanal makinelerde (UTM, VirtualBox, QEMU...) çoğunlukla 3B hızlandırma yoktur;
# wlroots'un GPU çizicisi hatalı bir yazılım yoluna (kms_swrast) düşer ve
# ekranda siyah bloklar/noktalar kalır. wlroots'un kendi yazılım çizicisi
# (pixman) ve yazılım imleci bu ortamlarda kararlı çalışır.
if command -v systemd-detect-virt >/dev/null 2>&1 && systemd-detect-virt --quiet --vm; then
    export WLR_RENDERER=${TRLDE_RENDERER:-pixman}
    export WLR_NO_HARDWARE_CURSORS=1
fi
export XCURSOR_THEME=${XCURSOR_THEME:-Adwaita}

system_config_dir=/usr/share/trlde/labwc
if [ -n "${TRLDE_CONFIG_DIR:-}" ]; then
    config_dir=$TRLDE_CONFIG_DIR
else
    config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/trlde/labwc
    install -d -m 0700 "$config_dir"
    if [ ! -r "$config_dir/rc.xml" ]; then
        cp "$system_config_dir/rc.xml" "$config_dir/rc.xml"
    fi
    cp "$system_config_dir/autostart" "$config_dir/autostart"
    case "${LANGUAGE:-${LC_ALL:-${LC_MESSAGES:-${LANG:-tr}}}}" in
        tr*|C|C.*|POSIX) menu_file=menu.xml ;;
        *) menu_file=menu.en.xml ;;
    esac
    [ -r "$system_config_dir/$menu_file" ] || menu_file=menu.xml
    cp "$system_config_dir/$menu_file" "$config_dir/menu.xml"
    cp "$system_config_dir/environment" "$config_dir/environment"
fi

if ! command -v labwc >/dev/null 2>&1; then
    printf '%s\n' "OrvixOS başlatılamadı: labwc bulunamadı." >&2
    exit 127
fi

if [ ! -r "$config_dir/rc.xml" ]; then
    printf '%s\n' "OrvixOS başlatılamadı: $config_dir/rc.xml okunamıyor." >&2
    exit 1
fi

cleanup_session() {
    systemctl --user stop trlde-session.target >/dev/null 2>&1 || true
}

trap cleanup_session EXIT HUP INT TERM
systemctl --user start trlde-session.target >/dev/null 2>&1 || true
labwc --config-dir "$config_dir"
