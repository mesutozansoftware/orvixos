#!/usr/bin/python3

"""OrvixOS'un günlük kullanım için merkezi ayarlar uygulaması."""

import os
import platform
import re
import subprocess
import sys

import gi

gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, GLib, Gtk
try:
    import sys as _trlde_sys
    _trlde_sys.path.insert(0, "/usr/share/trlde/i18n")
    import trlde_i18n
    trlde_i18n.install()
except Exception:
    pass


def output(argv, timeout=3):
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    try:
        return subprocess.run(
            argv, check=False, capture_output=True, text=True, timeout=timeout, env=env
        ).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def available(program):
    return bool(GLib.find_program_in_path(program))


def spawn(argv):
    try:
        subprocess.Popen(argv, start_new_session=True)
    except OSError:
        if available("notify-send"):
            subprocess.Popen(
                ["notify-send", "OrvixOS Ayarları", f"{argv[0]} kullanılamıyor."],
                start_new_session=True,
            )


def open_first(candidates):
    for argv in candidates:
        if available(argv[0]):
            spawn(argv)
            return
    if available("notify-send"):
        spawn(["notify-send", "OrvixOS Ayarları", "Bu ayar aracı sistemde bulunamadı."])


class Settings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.trlde.Settings")
        self.window = None
        self.refreshing = False
        self.volume_timer = 0

    def do_startup(self):
        Gtk.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_data(
            b"""
            window { background: #111820; color: #e7edf2; }
            headerbar { background: #18222d; color: #ffffff; border-bottom: 1px solid #39d6c5; }
            stacksidebar { background: #151f29; border-right: 1px solid #273442; }
            stacksidebar row { min-height: 48px; padding: 4px 10px; color: #b9c6cf; }
            stacksidebar row:selected { background: #273442; color: #39d6c5; }
            .page-title { font-size: 24px; font-weight: 800; color: #ffffff; }
            .section-title { font-size: 15px; font-weight: 800; color: #39d6c5; }
            .muted { color: #91a0ad; }
            button { min-height: 40px; border-radius: 9px; background: #202c38; color: #e7edf2; }
            button:hover { background: #314253; color: #39d6c5; }
            switch:checked { background: #39d6c5; }
            scale trough { min-height: 8px; border-radius: 8px; background: #273442; }
            scale highlight { border-radius: 8px; background: #39d6c5; }
            """
        )
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def page(self, title, subtitle=""):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_border_width(24)
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("page-title")
        box.pack_start(heading, False, False, 0)
        if subtitle:
            label = Gtk.Label(label=subtitle, xalign=0, wrap=True)
            label.get_style_context().add_class("muted")
            box.pack_start(label, False, False, 0)
        return box

    def section(self, box, title):
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("section-title")
        box.pack_start(label, False, False, 5)

    def action_button(self, label, callback):
        button = Gtk.Button(label=label)
        button.connect("clicked", lambda *_: callback())
        return button

    def do_activate(self):
        if self.window:
            self.window.present()
            return

        self.window = Gtk.ApplicationWindow(application=self)
        self.window.set_title("OrvixOS Ayarları")
        self.window.set_default_size(880, 610)
        self.window.set_size_request(720, 500)

        header = Gtk.HeaderBar(title="OrvixOS Ayarları")
        header.set_show_close_button(True)
        self.window.set_titlebar(header)

        layout = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self.window.add(layout)
        stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        stack.set_hexpand(True)
        stack.set_vexpand(True)
        sidebar = Gtk.StackSidebar(stack=stack)
        sidebar.set_size_request(205, -1)
        layout.pack_start(sidebar, False, False, 0)
        layout.pack_start(stack, True, True, 0)

        stack.add_titled(self.general_page(), "general", "Genel")
        stack.add_titled(self.connections_page(), "connections", "Bağlantılar")
        stack.add_titled(self.sound_page(), "sound", "Ses")
        stack.add_titled(self.display_page(), "display", "Ekran ve Görünüm")
        stack.add_titled(self.keyboard_page(), "keyboard", "Klavye ve Pencereler")
        stack.add_titled(self.accessibility_page(), "accessibility", "Erişilebilirlik")
        stack.add_titled(self.system_page(), "system", "Sistem")

        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)
        self.window.show_all()

    def general_page(self):
        box = self.page("Genel", "Sık kullanılan OrvixOS özellikleri")
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        actions = [
            ("Hızlı Ayarlar", lambda: spawn(["trlde-quick-settings"])),
            ("Dosyalar", lambda: open_first([["thunar"], ["xdg-open", os.path.expanduser("~")]])),
            ("Uygulama Menüsü", lambda: spawn(["trlde-launcher"])),
            ("Bildirim Merkezi", lambda: spawn(["trlde-notifications"])),
            ("Yazılım Merkezi", lambda: spawn(["trlde-software"])),
            ("Pano Geçmişi", lambda: spawn(["trlde-clipboard"])),
            ("Terminal", lambda: open_first([["xfce4-terminal"], ["foot"]])),
            ("Ekranı Kilitle", lambda: spawn(["trlde-lock"])),
        ]
        for index, (label, callback) in enumerate(actions):
            grid.attach(self.action_button(label, callback), index % 2, index // 2, 1, 1)
        box.pack_start(grid, False, False, 0)
        self.section(box, "Varsayılan uygulamalar")
        note = Gtk.Label(
            label="Web bağlantıları kurulumda seçilen tarayıcı (Vira Browser, Firefox veya Chromium), klasörler Thunar ve düz metin dosyaları Mousepad ile açılır.",
            xalign=0,
            wrap=True,
        )
        note.get_style_context().add_class("muted")
        box.pack_start(note, False, False, 0)
        return box

    def switch_row(self, title, description):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
        labels.pack_start(Gtk.Label(label=title, xalign=0), False, False, 0)
        detail = Gtk.Label(label=description, xalign=0, wrap=True)
        detail.get_style_context().add_class("muted")
        labels.pack_start(detail, False, False, 0)
        row.pack_start(labels, True, True, 0)
        control = Gtk.Switch(valign=Gtk.Align.CENTER)
        row.pack_end(control, False, False, 0)
        return row, control

    def connections_page(self):
        box = self.page("Bağlantılar", "Wi-Fi, Ethernet ve Bluetooth cihazlarını yönet")
        wifi_row, self.wifi = self.switch_row("Wi-Fi", "Kablosuz ağ bağlantısını aç veya kapat")
        self.wifi.connect("notify::active", self.toggle_wifi)
        box.pack_start(wifi_row, False, False, 0)
        bluetooth_row, self.bluetooth = self.switch_row(
            "Bluetooth", "Klavye, fare, kulaklık ve diğer cihazlar"
        )
        self.bluetooth.connect("notify::active", self.toggle_bluetooth)
        box.pack_start(bluetooth_row, False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        grid.attach(
            self.action_button("Ağ Bağlantıları", lambda: open_first([["nm-connection-editor"]])),
            0, 0, 1, 1,
        )
        grid.attach(
            self.action_button("Bluetooth Cihazları", lambda: spawn(["trlde-bluetooth", "settings"])),
            1, 0, 1, 1,
        )
        box.pack_start(grid, False, False, 4)
        self.connection_status = Gtk.Label(xalign=0, wrap=True)
        self.connection_status.get_style_context().add_class("muted")
        box.pack_start(self.connection_status, False, False, 0)
        return box

    def sound_page(self):
        box = self.page("Ses", "Hoparlör, kulaklık ve mikrofon düzeyleri")
        self.section(box, "Çıkış sesi")
        self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.volume.set_draw_value(True)
        self.volume.set_value_pos(Gtk.PositionType.RIGHT)
        self.volume.connect("value-changed", self.schedule_volume)
        box.pack_start(self.volume, False, False, 0)
        mute = self.action_button(
            "Sesi Aç / Kapat",
            lambda: spawn(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]),
        )
        box.pack_start(mute, False, False, 0)
        box.pack_start(
            self.action_button("Gelişmiş Ses Ayarları", lambda: open_first([["pavucontrol"]])),
            False, False, 0,
        )
        return box

    def display_page(self):
        box = self.page("Ekran ve Görünüm", "Çözünürlük, çoklu ekran, tema ve duvar kağıdı")
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        grid.attach(
            self.action_button("Ekranları Yapılandır", lambda: open_first([["wdisplays"]])),
            0, 0, 1, 1,
        )
        grid.attach(
            self.action_button("Duvar Kağıdı ve Tema", lambda: spawn(["trlde-appearance"])),
            1, 0, 1, 1,
        )
        grid.attach(
            self.action_button("Ekran Profilleri", lambda: spawn(["trlde-display-profiles"])),
            0, 1, 1, 1,
        )
        grid.attach(
            self.action_button("Ekran Kaydı", lambda: spawn(["trlde-recorder"])),
            1, 1, 1, 1,
        )
        box.pack_start(grid, False, False, 0)
        self.section(box, "Ekran görüntüsü")
        shot_grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        shot_grid.set_column_homogeneous(True)
        shot_grid.attach(
            self.action_button("Tüm Ekranı Kaydet", lambda: spawn(["trlde-screenshot", "full"])),
            0, 0, 1, 1,
        )
        shot_grid.attach(
            self.action_button("Alan Seçerek Kaydet", lambda: spawn(["trlde-screenshot", "area"])),
            1, 0, 1, 1,
        )
        box.pack_start(shot_grid, False, False, 0)
        return box

    def keyboard_page(self):
        box = self.page("Klavye ve Pencereler", "En önemli OrvixOS kısayolları")
        shortcuts = [
            ("Super + Space", "Uygulama menüsü"),
            ("Super + R", "Komut çalıştır"),
            ("Super + A", "Hızlı ayarlar"),
            ("Super + L", "Ekranı kilitle"),
            ("Super + Sol / Sağ", "Pencereyi ekranın yarısına döşe"),
            ("Super + 1…4", "Çalışma alanına geç"),
            ("Super + Shift + S", "Alan ekran görüntüsü"),
            ("Super + V", "Pano geçmişi"),
            ("Super + Shift + R", "Ekran kaydı"),
            ("Super + Shift + B", "Yedekleme ve kurtarma"),
            ("Alt + Tab", "Pencereler arasında geç"),
        ]
        grid = Gtk.Grid(column_spacing=18, row_spacing=10)
        for row, (keys, meaning) in enumerate(shortcuts):
            key = Gtk.Label(label=keys, xalign=0)
            key.get_style_context().add_class("section-title")
            grid.attach(key, 0, row, 1, 1)
            grid.attach(Gtk.Label(label=meaning, xalign=0), 1, row, 1, 1)
        box.pack_start(grid, False, False, 0)
        box.pack_start(
            self.action_button(
                "Klavye ve Dokunmatik Yüzeyi Yapılandır",
                lambda: spawn(["trlde-input"]),
            ),
            False, False, 8,
        )
        return box

    def accessibility_page(self):
        box = self.page("Erişilebilirlik", "Metin boyutu ve arayüz hareketleri")
        self.section(box, "Metin boyutu")
        sizes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        for label, factor in (("Normal", "1.0"), ("Büyük", "1.25"), ("Çok Büyük", "1.5")):
            sizes.pack_start(
                self.action_button(
                    label,
                    lambda value=factor: spawn(
                        ["gsettings", "set", "org.gnome.desktop.interface", "text-scaling-factor", value]
                    ),
                ),
                True, True, 0,
            )
        box.pack_start(sizes, False, False, 0)
        animation_row, self.animations = self.switch_row(
            "Arayüz animasyonları", "Pencere ve uygulama geçişlerindeki hareketler"
        )
        self.animations.connect("notify::active", self.toggle_animations)
        box.pack_start(animation_row, False, False, 0)
        return box

    def system_page(self):
        box = self.page("Sistem", "OrvixOS durumunu denetle")
        release = "Debian tabanlı"
        try:
            with open("/etc/os-release", encoding="utf-8") as release_file:
                for line in release_file:
                    if line.startswith("PRETTY_NAME="):
                        release = line.split("=", 1)[1].strip().strip('"')
                        break
        except OSError:
            pass
        info = Gtk.Label(
            label=f"OrvixOS 1.0\n{release}\n{platform.machine()}", xalign=0, selectable=True
        )
        box.pack_start(info, False, False, 0)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12)
        grid.set_column_homogeneous(True)
        actions = [
            ("OrvixOS Hakkında", lambda: spawn(["trlde-about"])),
            ("Sistem Denetimi", lambda: open_first([["foot", "-e", "trlde-doctor"], ["trlde-doctor"]])),
            ("Sistem Güncellemeleri", self.open_updates),
            ("Yazılım Merkezi", lambda: spawn(["trlde-software"])),
            ("Yedekleme ve Kurtarma", lambda: spawn(["trlde-backup"])),
            ("Sistem İzleyici", lambda: open_first([["gnome-system-monitor"], ["foot", "-e", "top"]])),
            ("Diskler", lambda: open_first([["gnome-disks"]])),
            ("Sürüm Bilgilerini Kopyala", self.copy_version),
        ]
        for index, (label, callback) in enumerate(actions):
            grid.attach(self.action_button(label, callback), index % 2, index // 2, 1, 1)
        box.pack_start(grid, False, False, 6)
        return box

    def refresh(self):
        self.refreshing = True
        wifi = output(["nmcli", "-t", "-f", "WIFI", "general"])
        self.wifi.set_sensitive(available("nmcli"))
        self.wifi.set_active(wifi == "enabled")

        bluetooth = output(["timeout", "2", "bluetoothctl", "show"])
        self.bluetooth.set_sensitive(bool(bluetooth))
        self.bluetooth.set_active("Powered: yes" in bluetooth)

        connection = output(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"])
        self.connection_status.set_text(
            "Etkin bağlantılar: " + connection.replace(":", " · ").replace("\n", ", ")
            if connection
            else "Etkin ağ bağlantısı bulunamadı."
        )

        volume = output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]) 
        match = re.search(r"Volume:\s+([0-9.]+)", volume)
        self.volume.set_sensitive(bool(match))
        self.volume.set_value(float(match.group(1)) * 100 if match else 0)

        animations = output(
            ["gsettings", "get", "org.gnome.desktop.interface", "enable-animations"]
        )
        self.animations.set_active(animations != "false")
        self.refreshing = False
        return True

    def toggle_wifi(self, switch, _property):
        if not self.refreshing:
            spawn(["nmcli", "radio", "wifi", "on" if switch.get_active() else "off"])

    def toggle_bluetooth(self, switch, _property):
        if not self.refreshing and switch.get_sensitive():
            spawn(["bluetoothctl", "power", "on" if switch.get_active() else "off"])

    def toggle_animations(self, switch, _property):
        if not self.refreshing:
            spawn(
                [
                    "gsettings", "set", "org.gnome.desktop.interface", "enable-animations",
                    "true" if switch.get_active() else "false",
                ]
            )

    def schedule_volume(self, scale):
        if self.refreshing:
            return
        if self.volume_timer:
            GLib.source_remove(self.volume_timer)
        self.volume_timer = GLib.timeout_add(140, self.apply_volume, scale.get_value())

    def apply_volume(self, value):
        spawn(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{value / 100:.2f}"])
        self.volume_timer = 0
        return False

    def open_updates(self):
        spawn(["trlde-update"])

    def copy_version(self):
        text = f"OrvixOS 1.0 | {platform.platform()} | {platform.machine()}"
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(text, -1)


Settings().run(sys.argv)
