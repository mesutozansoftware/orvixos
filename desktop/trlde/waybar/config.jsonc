{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "spacing": 2,

  "modules-left": ["custom/launcher", "wlr/taskbar"],
  "modules-center": [],
  "modules-right": ["tray", "custom/recorder", "network", "pulseaudio", "battery", "custom/quicksettings", "clock", "custom/notifications", "custom/power"],

  "custom/launcher": {
    "format": " ",
    "tooltip": true,
    "tooltip-format": "Başlat (Super + Boşluk) • Sağ tık: Ayarlar",
    "on-click": "trlde-launcher",
    "on-click-right": "trlde-settings"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 26,
    "tooltip-format": "{title}",
    "on-click": "activate",
    "on-click-middle": "close"
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  },

  "custom/recorder": {
    "exec": "trlde-recorder --status",
    "return-type": "json",
    "interval": 2,
    "on-click": "trlde-recorder",
    "on-click-right": "trlde-recorder --stop",
    "tooltip": true
  },

  "network": {
    "format-wifi": "",
    "format-ethernet": "",
    "format-linked": "",
    "format-disconnected": "",
    "tooltip-format-wifi": "{essid} • %{signalStrength}",
    "tooltip-format-ethernet": "Kablolu ağ • {ipaddr}",
    "tooltip-format-disconnected": "Ağ bağlantısı yok",
    "on-click": "nm-connection-editor",
    "on-click-right": "trlde-quick-settings"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "",
    "format-icons": { "default": ["", "", ""] },
    "tooltip-format": "Ses: %{volume}",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"
  },

  "battery": {
    "format": "{icon}",
    "format-charging": "",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "Pil: %{capacity}",
    "states": { "warning": 25, "critical": 10 }
  },

  "custom/quicksettings": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Hızlı ayarlar • Sağ tık: Ayarlar",
    "on-click": "trlde-quick-settings",
    "on-click-right": "trlde-settings"
  },

  "clock": {
    "format": "{:%H:%M\n%d.%m.%Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": { "mode": "month", "weeks-pos": "right" }
  },

  "custom/notifications": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Bildirim merkezi",
    "on-click": "trlde-notifications"
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Kapat, yeniden başlat, oturumu kapat",
    "on-click": "trlde-power"
  }
}
