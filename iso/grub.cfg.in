# OrvixOS @ORVIXOS_VERSION@ kurulum menüsü (@ARCH@)
# Menü metinleri ASCII: GRUB'un ISO'daki fontu Türkçe harfleri göstermiyor.
# @CONSOLE_ARGS@: preseed varken debian-installer yalnızca tercih edilen konsolda
# çalışır; ARM64'te (UTM dahil) ACPI SPCR seri portu seçtirir, ekran boş kalır.
set default=0
set timeout=15
set menu_color_normal=white/black
set menu_color_highlight=black/cyan
insmod gzio
insmod all_video
loadfont $prefix/font.pf2
set gfxpayload=keep

menuentry "OrvixOS @ORVIXOS_VERSION@ kur - grafik (Turkce)" --class orvixos {
    linux  /@INSTALL_DIR@/vmlinuz locale=tr_TR.UTF-8 keymap=tr @CONSOLE_ARGS@ --- quiet
    initrd /@INSTALL_DIR@/gtk/initrd.gz
}
menuentry "OrvixOS @ORVIXOS_VERSION@ kur - metin (Turkce)" --class orvixos {
    linux  /@INSTALL_DIR@/vmlinuz locale=tr_TR.UTF-8 keymap=tr @CONSOLE_ARGS@ --- quiet
    initrd /@INSTALL_DIR@/initrd.gz
}
menuentry "Install OrvixOS @ORVIXOS_VERSION@ - graphical (English)" --class orvixos {
    linux  /@INSTALL_DIR@/vmlinuz locale=en_US.UTF-8 keymap=us @CONSOLE_ARGS@ --- quiet
    initrd /@INSTALL_DIR@/gtk/initrd.gz
}
menuentry "Install OrvixOS @ORVIXOS_VERSION@ - text (English)" --class orvixos {
    linux  /@INSTALL_DIR@/vmlinuz locale=en_US.UTF-8 keymap=us @CONSOLE_ARGS@ --- quiet
    initrd /@INSTALL_DIR@/initrd.gz
}
submenu "Gelismis secenekler / Advanced options ..." {
    menuentry "Uzman kurulum / Expert install" {
        linux  /@INSTALL_DIR@/vmlinuz priority=low @CONSOLE_ARGS@ ---
        initrd /@INSTALL_DIR@/gtk/initrd.gz
    }
    menuentry "Kurtarma kipi / Rescue mode" {
        linux  /@INSTALL_DIR@/vmlinuz rescue/enable=true @CONSOLE_ARGS@ --- quiet
        initrd /@INSTALL_DIR@/gtk/initrd.gz
    }
}
