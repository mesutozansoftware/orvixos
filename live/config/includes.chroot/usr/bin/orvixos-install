#!/bin/sh
# OrvixOS kurulum programını (Calamares) başlatır — yalnızca canlı sistem.
# TRLDE bir Wayland oturumudur; Calamares root olarak aynı Wayland
# ekranına bağlanır.

if [ -e /etc/fstab ] && [ ! -e /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab /etc/fstab.orig.calamares
fi

platform=xcb
[ -n "${WAYLAND_DISPLAY:-}" ] && platform=wayland

sudo env \
    QT_QPA_PLATFORM="$platform" \
    QT_AUTO_SCREEN_SCALE_FACTOR=1 \
    XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
    WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
    DISPLAY="${DISPLAY:-}" \
    LANG="${LANG:-tr_TR.UTF-8}" \
    calamares "$@"
status=$?

if [ -e /etc/fstab.orig.calamares ]; then
    sudo mv /etc/fstab.orig.calamares /etc/fstab
fi
exit "$status"
