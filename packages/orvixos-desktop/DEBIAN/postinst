#!/bin/sh
set -e

set_browser() {
    case "$1" in
        vira) binary=/usr/bin/vira-browser; desktop=vira-browser.desktop ;;
        firefox) binary=/usr/bin/firefox-esr; desktop=firefox-esr.desktop ;;
        chromium) binary=/usr/bin/chromium; desktop=chromium.desktop ;;
        *) return 1 ;;
    esac
    [ -x "$binary" ] && [ -r "/usr/share/applications/$desktop" ] || return 1
    update-alternatives --set x-www-browser "$binary" >/dev/null 2>&1 || true
    update-alternatives --set gnome-www-browser "$binary" >/dev/null 2>&1 || true
    install -d /etc/xdg
    cat > /etc/xdg/mimeapps.list <<MIME
# OrvixOS varsayılan uygulamaları (orvixos-desktop tarafından üretildi)
[Default Applications]
x-scheme-handler/http=$desktop
x-scheme-handler/https=$desktop
inode/directory=thunar.desktop
text/plain=org.xfce.mousepad.desktop
MIME
}

case "$1" in
    configure)
        # Giriş ekranı: SDDM (OrvixOS teması).
        if [ -x /usr/bin/sddm ]; then
            printf '%s\n' /usr/bin/sddm > /etc/X11/default-display-manager
            systemctl enable --force sddm.service >/dev/null 2>&1 || true
        fi
        # Varsayılan tarayıcı: kurulumda seçilen (/etc/orvixos/browser),
        # yoksa kurulu olanlardan ilki (Vira Browser, Firefox ESR, Chromium).
        choice=
        if [ -r /etc/orvixos/browser ]; then
            read -r choice < /etc/orvixos/browser || true
        fi
        set_browser "$choice" || set_browser vira || set_browser firefox || set_browser chromium || true
        # Masaüstü ortamı olarak TRLDE.
        update-alternatives --set x-session-manager /usr/bin/trlde-session >/dev/null 2>&1 || true
        systemctl set-default graphical.target >/dev/null 2>&1 || true
        ;;
esac
exit 0
