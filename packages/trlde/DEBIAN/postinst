#!/bin/sh
set -e

case "$1" in
    configure)
        update-alternatives --install /usr/bin/x-session-manager \
            x-session-manager /usr/bin/trlde-session 60
        if command -v dconf >/dev/null 2>&1; then
            dconf update || true
        fi
        if command -v systemd-tmpfiles >/dev/null 2>&1; then
            systemd-tmpfiles --create /usr/lib/tmpfiles.d/trlde-x11.conf || true
        fi
        ;;
esac
exit 0
